# 一键部署：sudo bash deploy/install.sh 会自动生成这个文件里的密钥和内存档位，手动部署才需要逐项填
DOMAIN=:80
OWNER_USERNAME=me
OWNER_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
# ── 模型 ──
# 阶跃 Step Plan 的 key（platform.stepfun.ai → 接口密钥）。网关别名：fast=step-3.7-flash / smart=step-5-preview / lite=step-3.5-flash
STEP_API_KEY=
# 国内账号：STEP_BASE_URL=https://api.stepfun.com/step_plan/v1（同时改 deploy/litellm/config.yaml 的 api_base）
# STEP_BASE_URL=https://api.stepfun.ai/step_plan/v1
# 用 DeepSeek 时填这个并改 deploy/litellm/config.yaml
# DEEPSEEK_API_KEY=
LITELLM_MASTER_KEY=sk-litellm-change-me
# gateway = 启动 LiteLLM 网关容器；小 VPS 留空并用下面的直连模式
COMPOSE_PROFILES=gateway
DEFAULT_MODEL=fast
# 省内存的直连模式（小 VPS 可以不跑 LiteLLM 容器，约省 500MB 内存；但记忆向量检索要另配 embed）：
# LLM_BASE_URL=https://api.stepfun.ai/step_plan/v1
# LLM_API_KEY=同 STEP_API_KEY
# MODEL_MAP={"fast": "step-3.7-flash", "smart": "step-5-preview", "lite": "step-3.5-flash"}
# 语音：stepfun = 识别 stepaudio-2.5-asr + 服务器朗读 stepaudio-2.5-tts（自然很多）；gateway = 网关 stt + 设备朗读
VOICE_PROVIDER=stepfun
# STEP_TTS_VOICE=elegantgentle-female
# 输入框上可切换的模型（别名 → 显示名，顺序即切换顺序）；每个对话记住自己的选择
# CHAT_MODELS={"fast": "快速", "smart": "深度"}
# 长对话：每轮最多带多少字原文，更早的由 SUMMARY_MODEL（便宜模型）折叠成滚动摘要
SUMMARY_MODEL=lite
HISTORY_CHARS=24000
# 跨轮工具轨迹：最近几条回复把工具调用 + 截短结果放回历史（0 = 关）；每条最多多少字。开着每轮约多 4000 输入 token
# HISTORY_TRACE_TURNS=2
# HISTORY_TRACE_CHARS=6000
# 用量与花费（设置页“用量”卡片）：别名 → [输入, 输出] 每百万 token 的单价，按你供应商官网的价格填；不填只统计 token
# MODEL_PRICES={"fast": [2, 8], "smart": [4, 16]}
# 第三个数 = 命中提示缓存的输入单价（不填按输入价）：{"fast": [2, 8, 0.5]}
# 按对话发 prompt_cache_key（OpenAI 等认，提高缓存命中；不认的供应商会自动去掉）
# PROMPT_CACHE_KEY=false
# CURRENCY=CNY
# 每月预算（只提醒，不拦截），0 = 不设
# MONTHLY_BUDGET=0
# 本月花费跨过预算的这些比例时，在 Home 放一张提醒卡（每月每档一次；改预算会重新计）
# BUDGET_ALERTS=[0.8, 1.0]

# 数据目录（宿主机绝对路径）：项目文件、附件、自定义技能
HOST_DATA_DIR=/opt/assistant/data
# 后端调用沙盒的密钥：openssl rand -hex 24
SANDBOX_TOKEN=
# 保险箱主密钥（丢了就解不开已存的密钥，务必备份）：
# python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
VAULT_KEY=

# 外网访问地址（OAuth 回调：<PUBLIC_URL>/api/oauth/callback）
PUBLIC_URL=https://your.domain
# 原生 App 深链 scheme（默认 myassistant，一般不用改）
# APP_SCHEME=myassistant
# Google：console.cloud.google.com → 凭据 → OAuth 客户端（Web），回调填上面的地址
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub：Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 后端调用云浏览器的密钥：openssl rand -hex 24
BROWSER_TOKEN=

# 记忆向量检索（可选，免费额度）+ gateway 语音识别：cloud.siliconflow.cn 的 API Key
SILICONFLOW_API_KEY=

# ── 内存档位（docker-compose.yml 读这些；install.sh 在 <6GB 的机器上写小内存值） ──
# BROWSER_MAX_SESSIONS=1    # 云浏览器同时开着的会话数，超出时关掉最久没用的（登录状态会保存）
# BROWSER_MEM=1g
# BROWSER_SHM=512mb
# SANDBOX_MEM=512m          # 每个项目沙盒容器的内存上限
# JOB_MAX_SECONDS=3600      # 后台任务（run_command background）单个最长秒数
# JOB_MAX_RUNNING=2          # 每个项目同时最多几个后台任务（4GB 小 VPS 建议 2）
# SANDBOX_IDLE_MINUTES=10
# PG_SHARED_BUFFERS=128MB
# PG_CACHE_SIZE=512MB

# 一轮回复的预算：最多调用模型几次、累计多少 token（到了就收掉工具，让助手交代做到哪，回“继续”接着做）
# AGENT_MAX_STEPS=40
# AGENT_TURN_TOKENS=600000
# 同一步里连续的只读工具调用最多同时跑几个（1 = 关）
# AGENT_PARALLEL_TOOLS=8
# 话说一半就停（v1.64）：回复结尾像“接下来我去……”却没调用工具 → 替用户补“继续”。auto=规则闸门+便宜模型判官 / rules=只看规则 / off
# NEXT_SPEAKER_CHECK=auto
# NEXT_SPEAKER_MAX=2
# 工作区规则文件（AGENTS.md）每批最多多少字节；0 = 不读
# WORKSPACE_INSTRUCTIONS_BYTES=16384
# 断线后回答继续写多久（分钟，没人看着时）；0 = 断线即停
# TURN_OFFLINE_MINUTES=30
# 子助手（delegate）：一次最多并行几个（0 = 关闭）、每个的步数 / token / 分钟上限
# SUBAGENT_MAX_TASKS=4
# SUBAGENT_MAX_STEPS=20
# SUBAGENT_TURN_TOKENS=300000
# SUBAGENT_MINUTES=10
# 模型调用重试：限流 / 服务器错 / 超时 / 断网 / 空回复时自动重试几次（0 = 不重试），以及多久没新数据算超时（秒）
# LLM_MAX_RETRIES=5
# LLM_IDLE_SECONDS=120
# 重试用完仍失败时这一轮改用的备用模型（别名 → 别名），如 MODEL_FALLBACKS={"smart": "fast"}
# MODEL_FALLBACKS={}
# 上文窗口（token）：一轮里上文过 80% 先剪长工具结果、再把较早步骤压成摘要；按别名覆盖用 MODEL_CONTEXT={"smart":256000}
CONTEXT_TOKENS=128000
# 旧的大块工具结果换成预览 + 全文文件（省 token，无损）；MIN=0 关闭
# TOOL_MASK_PROTECT_TOKENS=24000
# TOOL_MASK_MIN_TOKENS=12000
# 思考强度（reasoning_effort）：按别名配可选档（从少到多）+ 默认；没配的模型不发这个参数。客户端会在模型钮旁出现“思考”档位
# MODEL_REASONING={"smart":{"levels":["low","medium","high"],"default":"medium"}}

# 看图：能直接收图片的模型别名（JSON）；其余别名看到的是图片的文字描述（用 VISION_MODEL 写一次并缓存）
# VISION_MODELS=["fast", "smart"]
# VISION_MODEL=fast
# IMAGE_MAX_SIDE=1280

# 服务器主机模式（install.sh --host-agent 自动填；不装就留空，功能不出现。装了也默认关，App“我的电脑”里打开）
# HOST_AGENT_SOCKET=/run/assistant-host/agent.sock
# HOST_AGENT_TOKEN=
# HOST_COMMAND_MAX_SECONDS=600
