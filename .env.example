DOMAIN=:80
OWNER_USERNAME=me
OWNER_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
DEEPSEEK_API_KEY=sk-xxx
LITELLM_MASTER_KEY=sk-litellm-change-me
# 网关里的模型别名：fast / smart
DEFAULT_MODEL=fast
# 输入框上可切换的模型（别名 → 显示名，顺序即切换顺序）；每个对话记住自己的选择
# CHAT_MODELS={"fast": "快速", "smart": "深度"}
# 长对话：每轮最多带多少字原文，更早的由 SUMMARY_MODEL（便宜模型）折叠成滚动摘要
SUMMARY_MODEL=fast
HISTORY_CHARS=24000
# 用量与花费（设置页“用量”卡片）：别名 → [输入, 输出] 每百万 token 的单价，按你供应商官网的价格填；不填只统计 token
# MODEL_PRICES={"fast": [2, 8], "smart": [4, 16]}
# CURRENCY=CNY
# 每月预算（只提醒，不拦截），0 = 不设
# MONTHLY_BUDGET=0
# 本月花费跨过预算的这些比例时，在 Home 放一张提醒卡（每月每档一次；改预算会重新计）
# BUDGET_ALERTS=[0.8, 1.0]

# 数据目录（宿主机绝对路径）：项目文件、附件、自定义技能
HOST_DATA_DIR=/opt/assistant/data
# 后端调用沙盒的密钥：openssl rand -hex 24
SANDBOX_TOKEN=
# 保险箱主密钥（丢了就解不开已存的密钥，务必备份）：
# python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
VAULT_KEY=

# 外网访问地址（OAuth 回调：<PUBLIC_URL>/api/oauth/callback）
PUBLIC_URL=https://your.domain
# 原生 App 深链 scheme（默认 myassistant，一般不用改）
# APP_SCHEME=myassistant
# Google：console.cloud.google.com → 凭据 → OAuth 客户端（Web），回调填上面的地址
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub：Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 后端调用云浏览器的密钥：openssl rand -hex 24
BROWSER_TOKEN=

# 语音识别 + 记忆向量检索（可选，都有免费额度）：cloud.siliconflow.cn 的 API Key
SILICONFLOW_API_KEY=
